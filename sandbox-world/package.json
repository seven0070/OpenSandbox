{
  "name": "arcane-physics",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A fantasy world that obeys real physical law, served from an OpenSandbox-style sandbox.",
  "scripts": {
    "serve": "node srv/serve.mjs",
    "test": "node --test tests/physics.test.mjs tests/gameplay.soak.test.mjs",
    "check": "node tools/check-imports.mjs",
    "boot": "node tools/boot-check.mjs",
    "verify": "npm run check && npm test && node tools/boot-check.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "files": [
    "index.html",
    "src",
    "vendor",
    "srv",
    "tools",
    "tests",
    "README.md"
  ]
}